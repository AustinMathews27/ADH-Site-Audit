{
  "appId": "com.adh.fieldaudit",
  "appName": "ADH Audit",
  "webDir": "www",
  "backgroundColor": "#16181d",
  "server": {
    "url": "https://proud-moss-067ef8e0f.6.azurestaticapps.net",
    "allowNavigation": [
      "*.azurestaticapps.net",
      "*.*.azurestaticapps.net",
      "login.microsoftonline.com",
      "*.login.microsoftonline.com",
      "login.microsoft.com",
      "login.live.com",
      "*.login.live.com"
    ]
  },
  "ios": {
    "contentInset": "never",
    "scrollEnabled": true,
    "limitsNavigationsToAppBoundDomains": true,
    "appendUserAgent": "ADHAuditNative",
    "backgroundColor": "#16181d",
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 20000,
      "launchFadeOutDuration": 350,
      "backgroundColor": "#2563eb",
      "showSpinner": true,
      "iosSpinnerStyle": "large",
      "spinnerColor": "#ffffff",
      "splashFullScreen": true,
      "splashImmersive": true
    }
  }
}
